{
   readline_malloc_any
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   fun:malloc
   ...
   obj:*/libreadline.so*
}
{
   readline_calloc_any
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   fun:calloc
   ...
   obj:*/libreadline.so*
}
{
   readline_realloc_any
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   fun:realloc
   ...
   obj:*/libreadline.so*
}
{
   readline_obj_only
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   obj:*/libreadline.so*
}
{
   readline_fun_readline
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:readline
}
{
   readline_add_history
   Memcheck:Leak
   match-leak-kinds: reachable,definite,indirect,possible
   ...
   fun:add_history
}
